<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Quản_lý_sinh_viên.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Quản lý Sinh viên</title>
    <meta charset="utf-8" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }
        body { background: #f5f5f5; }

        /* Header */
        .header {
            background: #2c3e50;
            color: white;
            height: 50px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            justify-content: space-between;
        }
        .header .logo { font-weight: bold; font-size: 18px; }
        .header .logo a { color: white; text-decoration: none; }
        .header .menu-top a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }
        .header .menu-top a:hover { color: #3498db; }

        /* Layout */
        .container { display: flex; min-height: calc(100vh - 50px); }

        /* Sidebar */
        .sidebar {
            width: 220px;
            background: #34495e;
            color: white;
            padding-top: 20px;
        }
        .sidebar a {
            display: block;
            color: #ecf0f1;
            text-decoration: none;
            padding: 12px 20px;
            font-size: 14px;
            border-left: 4px solid transparent;
        }
        .sidebar a:hover, .sidebar a.active {
            background: #2c3e50;
            border-left-color: #3498db;
        }
        .sidebar .menu-title {
            padding: 10px 20px;
            font-size: 12px;
            color: #95a5a6;
            text-transform: uppercase;
        }

        /* Content */
        .content {
            flex: 1;
            padding: 25px;
            background: white;
            margin: 15px;
            border-radius: 6px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }
        .page-title {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 8px;
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <!-- Header -->
        <div class="header">
            <div class="logo"><a href="TrangChu.aspx">ASP.NET</a></div>
            <div class="menu-top">
                <a href="#">Hệ thống</a>
                <a href="#">Hồ sơ</a>
                <a href="#">Báo cáo</a>
                <a href="#">Ứng dụng</a>
                <a href="#">Đăng nhập</a>
            </div>
        </div>

        <div class="container">
            <!-- Sidebar -->
            <div class="sidebar">
                <div class="menu-title">Menu</div>
                <a href="TrangChu.aspx">Trang chủ</a>
                <a href="#">Quản lý lớp học</a>
                <a href="WebForm1.aspx">Quản lý sinh viên</a>
                <a href="#">Tra cứu &amp; Điểm danh</a>
                <a href="#">Quản lý đăng nhập</a>
                <a href="#">Đăng xuất</a>
            </div>

            <div class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>

    <script>
// Tự động đánh dấu mục menu đang mở
var current = location.pathname.split('/').pop().toLowerCase();
document.querySelectorAll('.sidebar a').forEach(function (a) {
    if (a.getAttribute('href').toLowerCase() === current) {
        a.classList.add('active');
    }
});
</script>
</body>
</html>
